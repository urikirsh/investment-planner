# Normalize text files and keep repository line endings consistent.
* text=auto

# Source files
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf

# Project/data files
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.cfg text eol=lf

# Shell/config files
*.sh text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
